# Run the production channel configuration in isolated CMake processes.
file(MAKE_DIRECTORY "${TEST_DIR}")
file(WRITE "${TEST_DIR}/probe.cmake" "
set(PROJECT_VERSION 1.0.0)
include(\"${SOURCE_DIR}/cmake/version.cmake\")
configure_file(\"${SOURCE_DIR}/cmake/build-info.json.in\" \"${TEST_DIR}/metadata.json\" @ONLY)
")
function(check suffix expected_version expected_preview)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DSTRINGS_PRERELEASE=${suffix}"
        -P "${TEST_DIR}/probe.cmake" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Valid suffix '${suffix}' rejected: ${error}")
    endif()
    file(READ "${TEST_DIR}/metadata.json" metadata)
    string(JSON version GET "${metadata}" version)
    string(JSON preview GET "${metadata}" preview)
    if(NOT version STREQUAL expected_version OR NOT preview STREQUAL expected_preview)
        message(FATAL_ERROR "Incorrect metadata for '${suffix}': ${metadata}")
    endif()
endfunction()
check("" "1.0.0" OFF)
check("0" "1.0.0-0" ON)
check("off" "1.0.0-off" ON)
check("alpha.1" "1.0.0-alpha.1" ON)
check("rc.2" "1.0.0-rc.2" ON)
foreach(invalid IN ITEMS "bad suffix" "alpha..1" "../escape" "alpha/1")
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DSTRINGS_PRERELEASE=${invalid}"
        -P "${TEST_DIR}/probe.cmake" RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
    if(result EQUAL 0)
        message(FATAL_ERROR "Invalid suffix '${invalid}' accepted")
    endif()
endforeach()
